// PS4 / OpenOrbis libc++ configuration overlay.
//
// The OpenOrbis v0.5.3 release ships a 2021 libc++ archive (no C++23 headers).
// For CI we compile against a modern host libc++ (Ubuntu: libc++-18-dev) but
// link against the SDK's static libc++/libc++abi.  This header is placed in
// front of the host headers via -isystem; #include_next picks up the host's
// generated __config_site and we then force the musl/pthread configuration
// required by the OpenOrbis C library.
#ifndef _LIBCPP_PS4_CONFIG_SITE
#define _LIBCPP_PS4_CONFIG_SITE

#if __has_include_next(<__config_site>)
#  include_next <__config_site>
#endif

#ifndef _LIBCPP_HAS_MUSL_LIBC
#  define _LIBCPP_HAS_MUSL_LIBC 1
#endif
#ifndef _LIBCPP_HAS_THREAD_API_PTHREAD
#  define _LIBCPP_HAS_THREAD_API_PTHREAD 1
#endif
#ifndef _LIBCPP_PROVIDES_DEFAULT_RUNE_TABLE
#  define _LIBCPP_PROVIDES_DEFAULT_RUNE_TABLE 1
#endif

/* libc++ 18 still gates std::jthread/std::stop_token behind the experimental
 * flag.  reXGlue's timer_queue.cpp uses them under -std=c++23.  Opt in here,
 * but keep the other incomplete/experimental library features disabled so we
 * don't start depending on tzdb/PSTL/syncstream symbols absent from the
 * OpenOrbis SDK's 2021 static libc++. */
#ifndef _LIBCPP_ENABLE_EXPERIMENTAL
#  define _LIBCPP_ENABLE_EXPERIMENTAL
#endif
#ifndef _LIBCPP_HAS_NO_INCOMPLETE_PSTL
#  define _LIBCPP_HAS_NO_INCOMPLETE_PSTL
#endif
#ifndef _LIBCPP_HAS_NO_INCOMPLETE_TZDB
#  define _LIBCPP_HAS_NO_INCOMPLETE_TZDB
#endif
#ifndef _LIBCPP_HAS_NO_EXPERIMENTAL_SYNCSTREAM
#  define _LIBCPP_HAS_NO_EXPERIMENTAL_SYNCSTREAM
#endif

#endif  // _LIBCPP_PS4_CONFIG_SITE
